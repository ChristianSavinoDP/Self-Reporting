# GitHub
# Personal access token. Required scopes: repo (private) or public_repo (public only).
GITHUB_TOKEN=ghp_your_token_here

# GitHub organization name
GITHUB_ORG=yourorg

# Jira Cloud
# Base URL of your Atlassian instance (no trailing slash)
JIRA_URL=https://yourcompany.atlassian.net

# Email address of the Jira account used for API authentication
JIRA_EMAIL=your.email@company.com

# Jira API token (generate at https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_TOKEN=your_jira_api_token_here

# Jira project key (e.g. DBI, PROJ). OPTIONAL.
# Leave empty to query your tickets across ALL projects (by person, not project).
# Set it to scope the report to a single project.
JIRA_PROJECT_KEY=